NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_default_public_token
POSTGRES_PRISMA_URL="postgresql://postgres:supersecret@localhost:5432/mydb"
POSTGRES_URL_NON_POOLING="postgresql://postgres:supersecret@localhost:5432/mydb"
# Payload uses the same Postgres database as Prisma through its own adapter.
PAYLOAD_DATABASE_URL="postgresql://postgres:supersecret@localhost:5432/mydb"
# Generate a long, random server-only secret (for example: openssl rand -base64 32).
PAYLOAD_SECRET=replace_with_a_long_random_secret
# Vercel sets this automatically after a public Blob store is connected to the project.
# It is intentionally unused by ordinary local development, which stores uploads on disk.
BLOB_READ_WRITE_TOKEN=
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=
COMPOSE_FILE=docker/docker-compose.yml
DB_PASSWORD=supersecret
DB_USER=postgres
NEXT_PUBLIC_EMAILJS_VOLUNTEER_SERVICE_ID=service_itlkzak
NEXT_PUBLIC_EMAILJS_VOLUNTEER_TEMPLATE_ID=template_ee6s74u
NEXT_PUBLIC_EMAILJS_VOLUNTEER_PUBLIC_KEY=your_volunteer_public_key
NEXT_PUBLIC_EMAILJS_CONFIRMATION_SERVICE_ID=service_xkteori
NEXT_PUBLIC_EMAILJS_CONFIRMATION_TEMPLATE_ID=template_ldjot9t
NEXT_PUBLIC_EMAILJS_CONFIRMATION_PUBLIC_KEY=your_confirmation_public_key
